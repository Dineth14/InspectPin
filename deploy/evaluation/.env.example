# Copy to .env on the VM only. Enter a hostname without a scheme or path.
PUBLIC_HOST=
CONFIG_ENCRYPTION_KEY=
# Supply keys only from a verified Free organization or an unbilled Gemini project.
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
VISION_PROVIDER=groq
VISION_MODEL=qwen/qwen3.8-27b
# Local speech stays on the receiver. Use groq only with consent to send raw speech.
STT_PROVIDER=whisper
