# Copy to .env. Real local inference; no API credits needed.
HOST=127.0.0.1
PORT=5000
# Set HOST to your laptop LAN address AND set a strong shared token for the board.
DEVICE_TOKEN=
DATA_DIR=data
HF_HOME=models/huggingface
STT_PROVIDER=whisper
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
WHISPER_LANGUAGE=en
WHISPER_VAD=true
WHISPER_BEAM=5
WHISPER_LOCAL_ONLY=false
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
OLLAMA_URL=http://127.0.0.1:11434
# For cloud providers set LLM_MODEL explicitly, plus the appropriate key.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
TTS_PROVIDER=piper
PIPER_MODEL=models/en_US-lessac-medium.onnx
TTS_GAIN=0.35
VISION_PROVIDER=ollama
VISION_MODEL=qwen2.5vl:3b
VISION_MAX_IMAGE_BYTES=2097152
VISION_CONTEXT_SECONDS=300
CONVERSATION_MAX_TURNS=6
OCR_ENABLED=false
TESSERACT_COMMAND=tesseract
REQUEST_TIMEOUT=60
JOB_TIMEOUT=180
QUEUE_SIZE=4
MAX_JOBS=100
RETENTION_SECONDS=86400
MAX_VOICE_BYTES=1000000
MAX_IMAGE_BYTES=2000000
MIN_RMS=5
