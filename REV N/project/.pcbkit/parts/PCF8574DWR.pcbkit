    Description = "8-bit quasi-bidirectional I2C I/O expander, 2.5-6 V, addresses 0x20-0x27 by A2-A0 (PCF8574A: 0x38-0x3F), open-drain interrupt; the chip of the I2C backpacks of character LCDs (SOIC-16 wide)"
    PinoutSource = "TI PCF8574 datasheet SCPS068K, table 4-1 pin functions (DW or N column: 1-3 A0-A2, 4-7 P0-P3, 8 GND, 9-12 P4-P7, 13 INT, 14 SCL, 15 SDA, 16 VCC), 5.1, 5.3, 7.3.3"
    Datasheet = "https://www.ti.com/lit/ds/symlink/pcf8574.pdf"
  }
  simulation = SimulationParameters {
    behavior = Behavior {
      model = "pcf8574"
      ports = {
        "i2c" = ["15", "14"]
