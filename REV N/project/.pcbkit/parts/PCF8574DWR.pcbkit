    A0 = io.input(max = 7V)
    A1 = io.input(max = 7V)
    A2 = io.input(max = 7V)
    P0 = io.bidirectional()
    P1 = io.bidirectional()
    P2 = io.bidirectional()
    P3 = io.bidirectional()
    GND = .ground
    P4 = io.bidirectional()
    P5 = io.bidirectional()
    P6 = io.bidirectional()
    P7 = io.bidirectional()
    INT = io.openDrain()
    SCL = io.input(max = 7V)
    SDA = io.openDrain(max = 7V)
    VCC = io.powerIn(min = 2.5V, max = 7V)
  }
  fields {
    Status = "checked"
