        "p4" = ["9"]
        "p5" = ["10"]
        "p6" = ["11"]
        "p7" = ["12"]
        "power" = ["16", "8"]
      }
      parameters = {}
      height = 0mm
    }
    parameters = [
      SimulationParameter {
        id = "icc-operating-100khz"
        quantity = .supplyCurrent
        typ = 40uA
        max = 100uA
        conditions = "Operating mode, VI=VCC or GND, IO=0, fSCL=100 kHz; typical at VCC=5 V, TA=25 degC; max at VCC=6 V, over operating temperature"
        source = SimulationEvidence {
          url = "https://www.ti.com/lit/ds/symlink/pcf8574.pdf"
          revision = "SCPS068K, revised September 2024"
          location = "p. 5, section 5.5 Electrical Characteristics, ICC operating mode row"
          confidence = .datasheet
        }
      },
      SimulationParameter {
        id = "rthjb-dw16"
        quantity = .thetaJb
        typ = 45.8K/W
        conditions = "RthetaJB junction-to-board, DW package, 16 pins"
        source = SimulationEvidence {
          url = "https://www.ti.com/lit/ds/symlink/pcf8574.pdf"
          revision = "SCPS068K, revised September 2024"
