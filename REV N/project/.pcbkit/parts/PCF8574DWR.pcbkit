/// The support circuit of the PCF8574DWR as its datasheet shows it (8.2 typical application): every
/// part next to the pin it serves. Add it next to the part: `U1 = PCF8574DWR.PCF8574DWR { … }`,
/// `U1Support = PCF8574DWR.Support { chip = U1 }`.
///
/// - Address 0100 A2 A1 A0: 0x20-0x27 (NXP and TI PCF8574A: 0111 A2 A1 A0, 0x38-0x3F; same pins).
/// A2-A0 straight to VCC or GND.
///
/// - The ports are quasi-bidirectional: write 1 to read a pin as input; a high output is only a
/// weak current source (about 100 uA), so drive LEDs and loads low-side (sinking up to 25 mA).
block Support {
  /// The PCF8574DWR this circuit serves (`PCF8574DWR.Support { chip = U1 }`).
  chip: Any
  /// The I2C pull-ups (once per bus: `false` when another part of the bus has them).
  pullUps: Bool = true
  /// A0-A2 to GND: address 0x20 (`address20 = false` to strap them for another address).
  address20: Bool = true
  /// next to pin 16
  C1 = cap(100nF, package = "0402") {
    place = [soft(near(chip.pin.VCC, max = 2mm), weight = 2)]
    a -- chip.pin.VCC
    b -- chip.pin.GND
  }
  /// I2C pull-up, once per bus
  RP1 =
    if pullUps then res(4.7kohm, package = "0402") {
      place = [soft(near(chip.pin.SDA, max = 5mm), weight = 1)]
      a -- chip.pin.SDA
      b -- chip.pin.VCC
    }
    else null
  /// I2C pull-up, once per bus
  RP2 =
    if pullUps then res(4.7kohm, package = "0402") {
      place = [soft(near(chip.pin.SCL, max = 5mm), weight = 1)]
      a -- chip.pin.SCL
      b -- chip.pin.VCC
    }
    else null
  /// interrupt pull-up, when INT is used
  R1 = res(10kohm, package = "0402") {
    place = [soft(near(chip.pin.INT, max = 5mm), weight = 1)]
    a -- chip.pin.INT
    b -- chip.pin.VCC
  }
  chip.pin.A0 -- (if address20 then chip.pin.GND else chip.pin.A0)
  chip.pin.A1 -- (if address20 then chip.pin.GND else chip.pin.A1)
  chip.pin.A2 -- (if address20 then chip.pin.GND else chip.pin.A2)
}
