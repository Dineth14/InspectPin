pcbkit 2

// INA219AIDR (Texas Instruments): INA219 high-side current, bus voltage and power monitor, I2C
// (addresses 0x40-0x4F by A0/A1), bus 0-26 V, 3-5.5 V supply, SOIC-8
// Compiled from the part sheet `parts/INA219AIDR.json` (`parts.create`); status: checked.
// Datasheet: https://www.ti.com/lit/ds/symlink/ina219.pdf (SBOS448G (August 2008, revised December
// 2015): 6 pin configuration and functions, 7 specifications, 8.5.2 serial interface (Table 1),
// 9.2 typical application)
// Pins: TI INA219 datasheet SBOS448G: 6 pin configuration and functions (SOIC column), 7.1
// absolute maximum ratings, 7.3 recommended operating conditions, 8.5.2 Table 1 address pins, 9.2
// typical application
// Footprint: the standard package `SOIC-8 (D)`
// This file may be used, changed and shared without conditions, with the board or alone.

// Note: The common breakout boards use a 0.1 ohm shunt (±3.2 A, ±320 mV PGA range), A0 and A1
// pulled down (0x40).
// Note: The supply VS (3-5.5 V) is independent of the bus measured (0-26 V).

/// INA219AIDR — INA219 high-side current, bus voltage and power monitor, I2C (addresses 0x40-0x4F
/// by A0/A1), bus 0-26 V, 3-5.5 V supply, SOIC-8
part INA219AIDR: Part {
  footprint = soic(8)
  prefix = "U"
  mpn = "INA219AIDR"
  manufacturer = "Texas Instruments"
  pinout = { A1 = "1", A0 = "2", SDA = "3", SCL = "4", VS = "5", GND = "6", INN = "7", INP = "8" }
  pinTypes = {
    A1 = io.input()
    A0 = io.input()
    SDA = io.openDrain(max = 6V)
    SCL = io.input()
    VS = io.powerIn(min = 3V, max = 6V)
    GND = .ground
    INN = .passive
    INP = .passive
  }
  fields {
    Status = "checked"
    Sheet = "INA219AIDR"
    Description = "INA219 high-side current, bus voltage and power monitor, I2C (addresses 0x40-0x4F by A0/A1), bus 0-26 V, 3-5.5 V supply, SOIC-8"
    PinoutSource = "TI INA219 datasheet SBOS448G: 6 pin configuration and functions (SOIC column), 7.1 absolute maximum ratings, 7.3 recommended operating conditions, 8.5.2 Table 1 address pins, 9.2 typical application"
    Datasheet = "https://www.ti.com/lit/ds/symlink/ina219.pdf"
  }
  simulation = SimulationParameters {
    behavior = Behavior {
      model = "ina219"
      ports = { "i2c" = ["3", "4"], "power" = ["5", "6"] }
      parameters = {}
      height = 0mm
    }
    parameters = [
      SimulationParameter {
        id = "iq-active-3v3"
        quantity = .supplyCurrent
        typ = 700uA
        max = 1mA
        conditions = "Active, TA=25 degC, VS=3.3 V, VIN+=12 V, VSHUNT=32 mV, PGA=/1, BRNG=1; VS pin"
        source = SimulationEvidence {
          url = "https://www.ti.com/lit/ds/symlink/ina219.pdf"
          revision = "SBOS448G, August 2008, revised December 2015"
          location = "p. 6, section 7.5 Electrical Characteristics (continued), Quiescent current row"
          confidence = .datasheet
        }
      },
      SimulationParameter {
        id = "theta-jb-d8"
        quantity = .thetaJb
        typ = 52K/W
        conditions = "D (SOIC), 8 pins, JEDEC thermal test board"
        source = SimulationEvidence {
          url = "https://www.ti.com/lit/ds/symlink/ina219.pdf"
          revision = "SBOS448G, August 2008, revised December 2015"
          location = "p. 4, section 7.4 Thermal Information, RthetaJB"
          confidence = .datasheet
        }
      },
      SimulationParameter {
        id = "tj-absolute-max"
        quantity = .junctionAbsoluteTemperature
        max = 150degC
        conditions = "Junction temperature, absolute maximum rating"
        source = SimulationEvidence {
          url = "https://www.ti.com/lit/ds/symlink/ina219.pdf"
          revision = "SBOS448G, August 2008, revised December 2015"
          location = "p. 4, section 7.1 Absolute Maximum Ratings"
          confidence = .datasheet
        }
      },
    ]
  }
}

/// The support circuit of the INA219AIDR as its datasheet shows it (Figure 28 typical application
/// circuit; 9.2 (0.1 uF bypass); 8.5.2 Table 1 (addresses)): every part next to the pin it serves.
/// Add it next to the part: `U1 = INA219AIDR.INA219AIDR { … }`, `U1Support = INA219AIDR.Support {
/// chip = U1 }`.
///
/// - High side: IN+ to the supply, IN- to the load, the shunt between them; IN- also measures the
/// bus voltage. Kelvin-connect IN+ and IN- to the shunt pads.
///
/// - Optional input filter: 10 ohm in series with each input and 0.1-1 uF across IN+ and IN-
/// (Figure 28 RF, CF).
///
/// - Address by A1/A0: GND/GND 0x40, GND/VS 0x41, GND/SDA 0x42, GND/SCL 0x43, VS/GND 0x44 …
/// SCL/SCL 0x4F (16 addresses).
block Support {
  /// The INA219AIDR this circuit serves (`INA219AIDR.Support { chip = U1 }`).
  chip: Any
  /// The I2C pull-ups (once per bus: `false` when another part of the bus has them).
  pullUps: Bool = true
  /// A0-A1 to GND: address 0x40 (`address40 = false` to strap them for another address).
  address40: Bool = true
  /// next to the supply pin
  C1 = cap(100nF, package = "0402") {
    place = [soft(near(chip.pin.VS, max = 2mm), weight = 2)]
    a -- chip.pin.VS
    b -- chip.pin.GND
  }
  /// shunt in the measured supply line: 0.1 ohm gives 3.2 A full scale at the 320 mV range
  RSHUNT = res(100mohm, package = "1206") {
    place = [soft(near(chip.pin.INP, max = 5mm), weight = 1)]
    a -- chip.pin.INP
    b -- chip.pin.INN
  }
  /// I2C pull-up (once per bus)
  RP1 =
    if pullUps then res(10kohm, package = "0402") {
      place = [soft(near(chip.pin.SDA, max = 5mm), weight = 1)]
      a -- chip.pin.SDA
      b -- chip.pin.VS
    }
    else null
  /// I2C pull-up (once per bus)
  RP2 =
    if pullUps then res(10kohm, package = "0402") {
      place = [soft(near(chip.pin.SCL, max = 5mm), weight = 1)]
      a -- chip.pin.SCL
      b -- chip.pin.VS
    }
    else null
  chip.pin.A0 -- (if address40 then chip.pin.GND else chip.pin.A0)
  chip.pin.A1 -- (if address40 then chip.pin.GND else chip.pin.A1)
}
