pcbkit 2

// B2B-PH-K-S(LF)(SN) (J.S.T. Mfg.): JST PH 2-pin header, 2.0 mm pitch, top entry (vertical),
// through hole: the common LiPo battery connector, 2 A; contacts C1 C2 (polarity in the notes)
// Compiled from the part sheet `parts/B2B_PH_K_S.json` (`parts.create`); status: checked.
// Datasheet: https://www.jst-mfg.com/product/pdf/eng/ePH.pdf (JST PH connector catalog (ePH): PC
// board layout (through-hole, top entry) and header drawing)
// Pins: JST PH catalog: PC board layout and assembly layout (through-hole, top entry), header
// table (B2B-PH-K-S: A 2.0, B 5.9) and drawing (4.5 x 6 mm)
// Footprint: as given
// This file may be used, changed and shared without conditions, with the board or alone.

// Note: Battery polarity on JST PH is not standardised. Adafruit, SparkFun and Particle batteries
// share one convention: on the battery's plug, latch bump up and holes facing you, + (red) is on
// the right. Many other LiPo cells are wired the other way: measure the battery and print + and -
// beside the header before routing.
// Note: Connect the cell's + net to the contact it lands on, the other to GND; name the nets
// (VBAT, GND) rather than relying on the contact numbers.
// Note: Rated 2 A (AWG 24): enough for single-cell LiPo packs up to about 2 A discharge.
// Note: Mated height 8 mm; the plug enters from above.

/// B2B-PH-K-S(LF)(SN) — JST PH 2-pin header, 2.0 mm pitch, top entry (vertical), through hole:
/// the common LiPo battery connector, 2 A; contacts C1 C2 (polarity in the notes)
part B2B_PH_K_S: Part {
  footprint = Footprint {
    let ps = [
      thtPad("1", (-1mm, 0mm), 0.75mm, (1.3mm, 1.6mm), square = true),
      thtPad("2", (1mm, 0mm), 0.75mm, (1.3mm, 1.6mm)),
    ]
    let b = box((-2.95mm, -2.8mm), (2.95mm, 1.7mm))
    name = "JST_PH_B2B-PH-K_1x02_P2.00mm_Vertical"
    description = "JST PH header, 2 contacts at 2.0 mm, top entry, through hole (JST layout: 0.7 mm holes, housing 5.9 x 4.5 mm, the hole row 1.7 mm from its +Y side)"
    tags = ["JST", "PH", "connector", "THT", "vertical"]
    pads = ps
    body = b
    height = 6mm
    mating = .up
    silk = silkOf(ps, b, 0.25mm, pin1 = (-1mm, -1.25mm))
    package = Package { family = .other, body = (5.9mm, 4.5mm), height = 6mm }
    solids = wireToBoardBody(2, 2mm, -2.8mm, 1.7mm, 6mm, wall = 0.6mm)
  }
  prefix = "J"
  mpn = "B2B-PH-K-S(LF)(SN)"
  manufacturer = "J.S.T. Mfg."
  pinout = { C1 = "1", C2 = "2" }
  pinTypes = { C1 = .passive, C2 = .passive }
  fields {
    Status = "checked"
    Sheet = "B2B_PH_K_S"
    Description = "JST PH 2-pin header, 2.0 mm pitch, top entry (vertical), through hole: the common LiPo battery connector, 2 A; contacts C1 C2 (polarity in the notes)"
    PinoutSource = "JST PH catalog: PC board layout and assembly layout (through-hole, top entry), header table (B2B-PH-K-S: A 2.0, B 5.9) and drawing (4.5 x 6 mm)"
    Datasheet = "https://www.jst-mfg.com/product/pdf/eng/ePH.pdf"
  }
}
